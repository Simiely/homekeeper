# ===== HomeKeeper 配置样例 =====
# 复制为 .env 后按需修改（.env 不进 git）

# 宿主机访问端口（容器内固定 8000，此值仅决定对外暴露的端口）
APP_PORT=8000

# SQLite 数据库文件路径（容器内路径，对应 docker-compose 数据卷 ./data）
DATABASE_URL=sqlite:///./data/homekeeper.db

# JWT 签名密钥：生产环境务必替换为随机长字符串
# 生成示例：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# 首次启动自动创建的管理员密码（必须自行设置强密码！）
# 留空则启动时生成随机密码并打印在日志中，登录后请立即修改。
# 生成示例：python -c "import secrets;print(secrets.token_urlsafe(12))"
DEFAULT_ADMIN_PASSWORD=

# JWT 算法与有效期（分钟）
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS 允许来源（安卓端远程调用 / 反代域名，逗号分隔；* 表示全部，生产建议收紧）
CORS_ORIGINS=*

# 对外访问地址（用于二维码生成，留空则二维码显示物品名称）
# PUBLIC_URL=https://your-domain.com
